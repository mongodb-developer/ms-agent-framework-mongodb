          }
        }
      ]
    },
    {
      "name": "boolean membership and range",
      "ast": {
        "operator": "and",
        "filters": [
          {
            "operator": "in",
            "field": "kind",
            "values": ["guide", "reference"]
          },
          {
            "operator": "or",
            "filters": [

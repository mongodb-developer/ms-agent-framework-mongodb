              {
                "operator": "not_in",
                "field": "status",
                "values": ["deleted", "hidden"]
              }
            ]
          }
        ]
      },
      "vector": {
        "$and": [
          {
            "kind": {
              "$in": ["guide", "reference"]
            }
          },
          {
            "$or": [
              {
                "published_year": {
                  "$gte": 2025
                }
              },
              {
                "status": {
                  "$nin": ["deleted", "hidden"]
                }
              }
            ]
          }
        ]
      },
      "search": [
        {
          "in": {
            "path": "kind",
            "value": ["guide", "reference"]
          }
        },
        {
          "compound": {
            "should": [
              {
                "range": {
                  "path": "published_year",
                  "gte": 2025
                }
              },
              {
                "compound": {
                  "mustNot": [
                    {
                      "in": {
                        "path": "status",
                        "value": ["deleted", "hidden"]
                      }
                    }
                  ]
                }
              }
            ],
            "minimumShouldMatch": 1
          }
        }
      ]
    }

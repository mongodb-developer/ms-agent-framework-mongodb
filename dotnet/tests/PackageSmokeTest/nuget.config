<?xml version="1.0" encoding="utf-8"?>
<!--
  Isolated restore configuration for the clean-consumer package smoke test (docs/spec/quality-release.md "NuGet
  install and runtime smoke tests from the produced package, not project references"). `<clear />` removes any
  package sources inherited from a machine-wide NuGet.Config, so this project resolves MongoDB.AgentFramework
  only from the locally packed feed produced by `dotnet pack` (see ../../scripts/verify-package.ps1), and every
  other (transitive) dependency only from nuget.org, proving the packed artifact, not this repository's source
  tree, is what actually gets consumed.

  packageSourceMapping makes that restriction authoritative rather than merely incidental: without it, NuGet
  would search BOTH declared sources for every package, so a same-id/same-version MongoDB.AgentFramework
  package published to nuget.org in the future (or a misconfigured mirror) could silently satisfy the restore
  instead of the local packed artifact, without the restore ever failing or even warning. The mapping below
  makes MongoDB.AgentFramework resolvable EXCLUSIVELY from "local-packed-feed" and every other package
  resolvable exclusively from "nuget.org"; verify-package.ps1's Step 5 additionally proves, via
  ConsumerCacheVerification.ps1, that the restored MongoDB.AgentFramework library's recorded content hash
  matches the actual locally-packed .nupkg on disk, which packageSourceMapping alone cannot prove by itself.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-packed-feed" value="../../artifacts/packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-packed-feed">
      <package pattern="MongoDB.AgentFramework" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Isolated restore configuration for the clean-consumer package smoke test (docs/spec/quality-release.md "NuGet
  install and runtime smoke tests from the produced package, not project references"). `<clear />` removes any
  package sources inherited from a machine-wide NuGet.Config, so this project resolves MongoDB.AgentFramework
  only from the locally packed feed produced by `dotnet pack` (see ../../scripts/verify-package.ps1), and every
  other (transitive) dependency only from nuget.org, proving the packed artifact, not this repository's source
  tree, is what actually gets consumed.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-packed-feed" value="../../artifacts/packages" />
  </packageSources>
</configuration>

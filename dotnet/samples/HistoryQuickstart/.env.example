# Copy this file to .env. Existing process environment variables take precedence.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=agent_framework_samples
MONGODB_HISTORY_COLLECTION=chat_history
MONGODB_HISTORY_APPLICATION_ID=history-quickstart
MONGODB_HISTORY_AGENT_ID=sample-agent
MONGODB_HISTORY_SESSION_ID=history-quickstart-session
MONGODB_HISTORY_CLEAR=false

# Copy this file to .env. Existing process environment variables take precedence.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=agent_framework_samples
MONGODB_CHECKPOINT_COLLECTION=workflow_checkpoints
MONGODB_CHECKPOINT_WORKFLOW_ID=checkpoint-quickstart-workflow
MONGODB_CHECKPOINT_SESSION_ID=checkpoint-quickstart-run
MONGODB_CHECKPOINT_TENANT_ID=quickstart
MONGODB_CHECKPOINT_CLEAR=false
# Generate with: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
MONGODB_CHECKPOINT_SIGNING_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

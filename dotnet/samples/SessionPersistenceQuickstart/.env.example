# Copy this file to .env. Existing process environment variables take precedence.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=agent_framework_samples
MONGODB_SESSION_COLLECTION=agent_sessions
MONGODB_SESSION_APPLICATION_ID=session-quickstart
MONGODB_SESSION_AGENT_ID=sample-agent
MONGODB_SESSION_ID=session-quickstart-session
MONGODB_SESSION_CLEAR=false
